# FinGuard AI Backend Environment
# Copy to .env and adjust as needed. Never commit real secrets.

# Database
# Local dev (SQLite fallback - no install required):
DATABASE_URL=sqlite:///./finguard.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://finguard:finguard@postgres:5432/finguard

# Security
JWT_SECRET_KEY=please-change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM / NLP provider
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Set to true only when an LLM API key is configured
LLM_ENABLED=false

# CORS
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Risk thresholds (prototype values)
RISK_LOW_MEDIUM=30
RISK_MEDIUM_HIGH=60
RISK_HIGH_CRITICAL=80

# Seeding
AUTO_SEED=true
DEMO_USER_EMAIL=demo@finguard.ai
DEMO_USER_PASSWORD=demo123
