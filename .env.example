# FinGuard AI - Frontend & Fullstack Environment Variables
# Copy to .env for local development

# Frontend API Connection
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=FinGuard AI
VITE_APP_VERSION=1.0.0

# Backend & Database Configuration (for Docker Compose)
POSTGRES_USER=finguard
POSTGRES_PASSWORD=finguard_secure_password
POSTGRES_DB=finguard

# Backend JWT Configuration
JWT_SECRET_KEY=change-me-to-a-secure-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Assistant (Optional)
LLM_ENABLED=false
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
